-- Regression tests for ddlx bug fixes. Needs a superuser (roles, FDW, SET ROLE).
-- Every section runs in its own transaction that is rolled back, so the sections
-- are independent and a failure in one cannot hide the others.
-- Passing checks produce no output: they are plpgsql ASSERTs, and where possible
-- the generated DDL is executed, not just inspected.
-- 2. FDW without handler and validator
begin;
create schema fix_test;
set local search_path = fix_test, public;
create foreign data wrapper fix_fdw;
do $$
declare s text;
begin
  s := ddlx_create_foreign_data_wrapper(
         (select oid from pg_foreign_data_wrapper where fdwname = 'fix_fdw'));
  assert s like '%NO HANDLER%',   'expected NO HANDLER: '   || s;
  assert s like '%NO VALIDATOR%', 'expected NO VALIDATOR: ' || s;
  assert s not like '%HANDLER -%' and s not like '%VALIDATOR -%',
         'must not print a zero regproc: ' || s;
end $$;
rollback;
-- 3. foreign tables: SERVER is always emitted, OPTIONS only when present
begin;
create schema fix_test;
set local search_path = fix_test, public;
create foreign data wrapper fix_fdw;
create server fix_srv foreign data wrapper fix_fdw;
create foreign table fix_ft1 (a int) server fix_srv;
create foreign table fix_ft2 (a int) server fix_srv options (k 'v');
do $$
declare s1 text; s2 text;
begin
  s1 := ddlx_create_table('fix_ft1'::regclass);
  s2 := ddlx_create_table('fix_ft2'::regclass);
  assert s1 like '%SERVER fix_srv%', 'SERVER missing without options: ' || s1;
  assert s1 not like '%OPTIONS%',    'unexpected OPTIONS: ' || s1;
  assert s2 like '%SERVER fix_srv OPTIONS (%', 'SERVER/OPTIONS wrong: ' || s2;
end $$;
-- 4. lite mode: no DEFAULT for generated columns (PG12+)
do $$
declare s text;
begin
  if current_setting('server_version_num')::int >= 120000 then
    execute 'create table fix_gen (a int, b int generated always as (a * 2) stored, c int default 5)';
    s := ddlx_create_table('fix_gen'::regclass, '{lite}');
    assert s like '%GENERATED ALWAYS AS (%', 'generated clause missing: ' || s;
    assert s like '%DEFAULT 5%',             'lite must keep normal defaults: ' || s;
    assert (length(s) - length(replace(s, ' DEFAULT ', ''))) / length(' DEFAULT ') = 1,
           'exactly one DEFAULT expected (column c): ' || s;
  end if;
end $$;
rollback;
-- 5. extension rows: real schema name and quoted identifier
begin;
do $$ begin
  assert exists (select 1 from pg_extension), 'need at least one extension';
  assert not exists (
    select 1
      from pg_extension e
     cross join lateral ddlx_identify(e.oid) i
     where i.classid = 'pg_extension'::regclass
       and (i.sql_identifier <> quote_ident(e.extname)
            or i.namespace is distinct from
               (select nspname from pg_namespace where oid = e.extnamespace))),
    'extension identity must use quote_ident and the schema name';
end $$;
rollback;
-- 6. GRANT/REVOKE on aggregates and procedures: FUNCTION / PROCEDURE, never AGGREGATE
begin;
create schema fix_test;
set local search_path = fix_test, public;
create role "Fix Role";
create aggregate fix_agg(int) (sfunc = int4pl, stype = int);
revoke execute on function fix_agg(int) from public;
grant execute on function fix_agg(int) to "Fix Role";
do $$
declare s text;
begin
  s := ddlx_grants('fix_agg(int)'::regprocedure::oid);
  assert s like 'REVOKE ALL ON FUNCTION fix_agg(integer) FROM PUBLIC;%',
         'REVOKE on an aggregate must say FUNCTION: ' || s;
  assert s like '%GRANT EXECUTE ON FUNCTION fix_agg(integer) TO "Fix Role";%',
         'GRANT on an aggregate must say FUNCTION and quote the role: ' || s;
  assert s not like '%AGGREGATE%', 'AGGREGATE is not valid in GRANT: ' || s;
  execute s;   -- must be accepted by the server
  assert has_function_privilege('Fix Role', 'fix_agg(int)', 'execute'),
         'privilege must survive the round trip';
  assert not has_function_privilege('public', 'fix_agg(int)', 'execute'),
         'PUBLIC must stay revoked';

  -- the kind keyword is always present, also for window functions
  s := ddlx_grants('row_number()'::regprocedure::oid);
  assert s like 'REVOKE ALL ON FUNCTION row_number() FROM PUBLIC;%' and s not like '%WINDOW%', s;

  if current_setting('server_version_num')::int >= 110000 then
    execute 'create procedure fix_proc() language sql as ''select 1''';
    execute 'revoke execute on procedure fix_proc() from public';
    execute 'grant execute on procedure fix_proc() to "Fix Role"';
    s := ddlx_grants((select oid from pg_proc where proname = 'fix_proc'));
    assert s like 'REVOKE ALL ON PROCEDURE fix_proc() FROM PUBLIC;%'
       and s like '%GRANT EXECUTE ON PROCEDURE fix_proc() TO "Fix Role";%',
           'procedures must say PROCEDURE: ' || s;
    execute s;
  end if;
end $$;
rollback;
-- 7. GRANT on foreign tables: there is no "ON FOREIGN TABLE"
begin;
create schema fix_test;
set local search_path = fix_test, public;
create role "Fix Role";
create foreign data wrapper fix_fdw;
create server fix_srv foreign data wrapper fix_fdw;
create foreign table fix_ft (a int) server fix_srv;
grant select on fix_ft to "Fix Role";
do $$
declare s text;
begin
  s := ddlx_grants('fix_ft'::regclass::oid);
  assert s like '%GRANT SELECT ON fix_ft TO "Fix Role";%',
         'foreign table GRANT must use the plain table syntax: ' || s;
  assert s not like '%FOREIGN TABLE%', 'FOREIGN TABLE is not valid in GRANT: ' || s;
  execute s;
end $$;
rollback;
-- 8. Grantees, owners and column names that need quoting
begin;
create schema fix_test;
set local search_path = fix_test, public;
create role "Fix Role";
create role "Own Er";
create table fix_tab (id int);
grant select on fix_tab to "Fix Role";
create table fix_owned (id int);
alter table fix_owned owner to "Own Er";
grant select on fix_owned to "Fix Role";
create table fix_cols ("Col One" int, plain int);
grant select ("Col One") on fix_cols to "Fix Role";
do $$
declare s text;
begin
  s := ddlx_grants('fix_tab'::regclass::oid);
  assert s like '%TO "Fix Role";%', 'grantee must be quoted exactly once: ' || s;
  assert s not like '%"""%',        'grantee must not be quoted twice: ' || s;
  execute s;

  -- the owner's own (implicit) grants are filtered even when the name needs quoting
  s := ddlx_grants('fix_owned'::regclass::oid);
  assert s like '%TO "Fix Role";%',  'expected grant to Fix Role: ' || s;
  assert s not like '%TO "Own Er"%', 'owner grants must be filtered: ' || s;

  s := ddlx_grants_columns('fix_cols'::regclass);
  assert s like '%GRANT SELECT ("Col One") ON fix_cols TO "Fix Role";%',
         'column name must be quoted: ' || s;
  execute s;
end $$;
rollback;
-- 9. Policies: role names are quoted, PUBLIC stays bare
begin;
create schema fix_test;
set local search_path = fix_test, public;
create role "Fix Role";
create role "Own Er";
create table fix_pol (id int);
alter table fix_pol enable row level security;
create policy fix_p1 on fix_pol for select to "Fix Role", "Own Er" using (true);
create policy fix_p2 on fix_pol for select to public using (true);
do $$
declare s text; o oid;
begin
  select oid into o from pg_policy where polname = 'fix_p1';
  s := ddlx_create_policy(o);
  assert s like '%TO "Fix Role", "Own Er"%', 'policy roles must be quoted: ' || s;
  execute 'drop policy fix_p1 on fix_pol';
  execute s;   -- round trip

  select oid into o from pg_policy where polname = 'fix_p2';
  s := ddlx_create_policy(o);
  assert s like '%TO PUBLIC%' and s not like '%"PUBLIC"%',
         'PUBLIC must not be quoted: ' || s;
  execute 'drop policy fix_p2 on fix_pol';
  execute s;
end $$;
rollback;
-- 10. Publications: row filters use WHERE (expr), not CHECK (PG15+)
begin;
set local client_min_messages = error;  -- wal_level warnings depend on the cluster
create schema fix_test;
set local search_path = fix_test, public;
do $$
declare s text; o oid; n text;
begin
  if current_setting('server_version_num')::int >= 150000 then
    execute 'create table fix_pub_t (a int primary key, b int)';
    execute 'create publication fix_pub for table fix_pub_t (a) where (a > 0)';
    select oid into o from pg_publication where pubname = 'fix_pub';
    s := ddlx_create_publication(o);
    assert s like '%ADD TABLE fix_pub_t (a) WHERE (%', 'row filter must use WHERE: ' || s;
    assert s not like '%CHECK%', 'CHECK is not valid here: ' || s;
    execute 'drop publication fix_pub';
    execute s;   -- round trip
    assert (select prqual is not null and prattrs is not null
              from pg_publication_rel
             where prpubid = (select oid from pg_publication where pubname = 'fix_pub')),
           'row filter and column list must be restored';

    -- pg_get_expr does not parenthesize everything (a bare column or a constant),
    -- but the syntax is WHERE ( expression ): the parentheses must always be emitted
    execute 'create table fix_pub_b (a int primary key, active boolean)';
    execute 'create publication fix_pub_b1 for table fix_pub_b where (active)';
    execute 'create publication fix_pub_b2 for table fix_pub_b where (true)';
    foreach n in array array['fix_pub_b1', 'fix_pub_b2'] loop
      select oid into o from pg_publication where pubname = n;
      s := ddlx_create_publication(o);
      assert s like '%WHERE (%', 'row filter must be parenthesized: ' || s;
      execute format('drop publication %I', n);
      execute s;   -- must be accepted by the server
    end loop;
  end if;
end $$;
rollback;
-- 11. Subscriptions: two_phase state mapping, publication names quoted (PG15+)
begin;
set local client_min_messages = error;  -- "not connected" / wal_level warnings
do $$
declare s text; o oid;
begin
  if current_setting('server_version_num')::int >= 150000 then
    execute $c$create subscription fix_sub connection 'dbname=nonexistent'
               publication "Pub One", fix_pub2
               with (connect = false, two_phase = true, slot_name = none)$c$;
    select oid into o from pg_subscription where subname = 'fix_sub';
    s := ddlx_create_subscription(o);
    assert s like '%two_phase=true%', 'pending/enabled two_phase must map to true: ' || s;
    assert s not like '%two_phase=p%' and s not like '%two_phase=e%',
           'raw state letters are not valid: ' || s;
    assert s like '%PUBLICATION "Pub One", fix_pub2%', 'publication names must be quoted: ' || s;

    execute $c$create subscription fix_sub2 connection 'dbname=nonexistent'
               publication fix_pub2
               with (connect = false, two_phase = false, slot_name = none)$c$;
    select oid into o from pg_subscription where subname = 'fix_sub2';
    s := ddlx_create_subscription(o);
    assert s like '%two_phase=false%', 'disabled two_phase must map to false: ' || s;
  end if;
end $$;
rollback;
-- 12. Extension in a schema that needs quoting (skipped if no suitable contrib module)
begin;
set local client_min_messages = warning;  -- CASCADE may emit notices
create schema "Ext Schema";
do $$
declare s text; ext text; o oid;
begin
  select name into ext
    from pg_available_extension_versions v
   where relocatable and name in ('citext','hstore','btree_gin','btree_gist',
                                  'fuzzystrmatch','intarray','ltree','pg_trgm','cube')
   order by name limit 1;
  if ext is not null then
    execute format('create extension %I schema "Ext Schema" cascade', ext);
    select oid into o from pg_extension where extname = ext;
    s := ddlx_create_extension(o);
    assert s like '%SCHEMA "Ext Schema"%', 'schema must be quoted: ' || s;
    assert s not like '%"""%', 'schema must not be quoted twice: ' || s;
    execute format('drop extension %I cascade', ext);
    execute s;   -- round trip, using ddlx_create_extension output
  end if;
end $$;
rollback;
-- 13. Function grants are read from proacl
-- 13a. Default privileges: PUBLIC keeps EXECUTE, the owner is never listed
begin;
create schema fix_test;
set local search_path = fix_test, public;
create function fix_default() returns int language sql as 'select 1';
do $$
declare s text;
begin
  s := ddlx_grants('fix_default()'::regprocedure::oid);
  assert s = E'REVOKE ALL ON FUNCTION fix_default() FROM PUBLIC;\n'
          || E'GRANT EXECUTE ON FUNCTION fix_default() TO PUBLIC;\n',
         'default ACL must give REVOKE plus PUBLIC only: ' || s;
  execute s;
  assert has_function_privilege('public', 'fix_default()', 'execute'), 'round trip';
end $$;
rollback;
-- 13b. Explicit grants: grant option, quoted role, owner filtered, GRANTED BY
begin;
create schema fix_test;
set local search_path = fix_test, public;
create role "Fix Role";
create role "Own Er";
create function fix_explicit() returns int language sql as 'select 1';
revoke execute on function fix_explicit() from public;
grant execute on function fix_explicit() to "Fix Role" with grant option;
grant execute on function fix_explicit() to "Own Er";
do $$
declare s text;
begin
  s := ddlx_grants('fix_explicit()'::regprocedure::oid);
  assert s like '%GRANT EXECUTE ON FUNCTION fix_explicit() TO "Fix Role" WITH GRANT OPTION;%',
         'grant option must be reported: ' || s;
  assert s like E'%GRANT EXECUTE ON FUNCTION fix_explicit() TO "Own Er";\n%',
         'plain grant must not carry a grant option: ' || s;
  assert s not like '%TO ' || quote_ident(current_user) || '%',
         'the owner must not be listed: ' || s;
  assert s not like '%TO PUBLIC%', 'PUBLIC was revoked: ' || s;
  execute s;
  assert has_function_privilege('Fix Role', 'fix_explicit()', 'execute');
  assert not has_function_privilege('public', 'fix_explicit()', 'execute');

  -- the default options and the full definition agree
  assert s = ddlx_grants('fix_explicit()'::regprocedure::oid, '{}'), 'default options';
  assert ddlx_create('fix_explicit()'::regprocedure::oid)
         like '%GRANT EXECUTE ON FUNCTION fix_explicit() TO "Fix Role" WITH GRANT OPTION;%',
         'ddlx_create must include function grants';

  -- GRANTED BY is only emitted on request (PG14+)
  if current_setting('server_version_num')::int >= 140000 then
    assert s not like '%GRANTED BY%', 'no GRANTED BY by default: ' || s;
    s := ddlx_grants('fix_explicit()'::regprocedure::oid, '{grantor}');
    assert s not like '%GRANTED BY%', 'grantor equal to current_user is omitted: ' || s;

    -- grants made by somebody else are attributed to that role
    execute 'create function fix_granted() returns int language sql as ''select 1''';
    execute 'alter function fix_granted() owner to "Own Er"';
    execute 'revoke execute on function fix_granted() from public';
    execute 'grant execute on function fix_granted() to "Fix Role"';
    s := ddlx_grants('fix_granted()'::regprocedure::oid, '{grantor}');
    assert s like '%TO "Fix Role" GRANTED BY "Own Er";%', 'GRANTED BY expected: ' || s;
  end if;
end $$;
rollback;
-- 13c. A caller who is neither owner nor grantee still sees the full ACL
-- (information_schema.routine_privileges hides rows from such callers)
begin;
create schema fix_test;
set local search_path = fix_test, public;
create role "Fix Role";
create role "Own Er";
create function fix_hidden() returns int language sql as 'select 1';
revoke execute on function fix_hidden() from public;
grant execute on function fix_hidden() to "Own Er";
do $$
declare s text; o oid;
begin
  o := 'fix_hidden()'::regprocedure::oid;
  set local role "Fix Role";
  s := ddlx_grants(o);
  reset role;
  assert s like '%GRANT EXECUTE ON FUNCTION % TO "Own Er";%',
         'grants must be visible to unrelated callers: ' || s;
end $$;
rollback;
-- 14. Domains: constraint names survive, NOT NULL is emitted (typnotnull before PG17)
begin;
create schema fix_test;
set local search_path = fix_test, public;
create domain fix_dom as int not null default 5
  constraint "Pos Check" check (value > 0)
  constraint small check (value < 100);
do $$
declare s text; s2 text;
begin
  s := ddlx_create_type_domain('fix_dom'::regtype);
  assert s like '%CONSTRAINT "Pos Check" CHECK%', 'constraint name lost: ' || s;
  assert s like '%CONSTRAINT small CHECK%', 'constraint name lost: ' || s;
  assert s like '%NOT NULL%', 'NOT NULL lost: ' || s;
  assert s like '%DEFAULT 5%', 'DEFAULT lost: ' || s;

  execute 'drop domain fix_dom';
  execute s;
  s2 := ddlx_create_type_domain('fix_dom'::regtype);
  assert s2 = s, 'round trip differs: ' || s || ' <> ' || s2;
  assert (select count(*) from pg_constraint
           where contypid = 'fix_dom'::regtype and conname in ('Pos Check','small')) = 2,
         'named constraints not recreated';
  begin
    perform null::int::fix_dom;
    assert false, 'NOT NULL not enforced after round trip';
  exception when not_null_violation then null;
  end;
end $$;
rollback;
-- 15. Aggregates: ordered-set, hypothetical-set, zero-argument and FINALFUNC_MODIFY
begin;
create schema fix_test;
set local search_path = fix_test, public;
create aggregate fix_pctl(double precision order by anyelement) (
  sfunc = ordered_set_transition, stype = internal,
  finalfunc = percentile_disc_final, finalfunc_extra);
create aggregate fix_rank(variadic "any" order by variadic "any") (
  sfunc = ordered_set_transition_multi, stype = internal,
  finalfunc = rank_final, finalfunc_extra, hypothetical);
create aggregate fix_cnt(*) (sfunc = int8inc, stype = int8, initcond = '0');
do $$
declare s text; s2 text; r double precision; k text;
begin
  -- ordered-set
  s := ddlx_create_aggregate('fix_pctl(double precision, anyelement)'::regprocedure::regproc);
  assert s like '%ORDER BY%', 'ORDER BY missing: ' || s;
  execute 'drop aggregate fix_pctl(double precision, anyelement)';
  execute s;
  assert (select aggkind from pg_aggregate where aggfnoid = 'fix_pctl(double precision, anyelement)'::regprocedure) = 'o',
         'not recreated as ordered-set';
  execute 'select fix_pctl(0.5) within group (order by x) from generate_series(1,9) x' into r;
  assert r = 5, 'ordered-set aggregate does not work after round trip';
  assert ddlx_create_aggregate('fix_pctl(double precision, anyelement)'::regprocedure::regproc) = s,
         'ordered-set round trip differs';

  -- hypothetical-set
  s := ddlx_create_aggregate('fix_rank("any")'::regprocedure::regproc);
  assert s like '%HYPOTHETICAL%' and s like '%ORDER BY%', 'hypothetical: ' || s;
  execute 'drop aggregate fix_rank(variadic "any" order by variadic "any")';
  execute s;
  assert (select aggkind from pg_aggregate where aggfnoid = 'fix_rank("any")'::regprocedure) = 'h',
         'not recreated as hypothetical-set';
  execute 'select fix_rank(3) within group (order by x) from generate_series(1,9) x' into r;
  assert r = 3, 'hypothetical-set aggregate does not work after round trip';

  -- zero-argument aggregate is written with (*)
  s := ddlx_create_aggregate('fix_cnt()'::regprocedure::regproc);
  assert s like 'CREATE AGGREGATE %fix_cnt(*) (%', 'zero-arg aggregate must use (*): ' || s;
  execute 'drop aggregate fix_cnt(*)';
  execute s;
  execute 'select fix_cnt(*) from generate_series(1,4)' into r;
  assert r = 4, 'count(*)-style aggregate broken';
end $$;
rollback;
-- 15b. FINALFUNC_MODIFY / MFINALFUNC_MODIFY (PG11+)
begin;
create schema fix_test;
set local search_path = fix_test, public;
do $$
declare s text;
begin
  if current_setting('server_version_num')::int >= 110000 then
    execute 'create aggregate fix_fm(int) (sfunc = int4pl, stype = int4, finalfunc = int4inc,
                                           finalfunc_modify = read_write)';
    execute 'create aggregate fix_fs(int) (sfunc = int4pl, stype = int4, finalfunc = int4inc,
                                           finalfunc_modify = shareable)';
    execute 'create aggregate fix_fr(int) (sfunc = int4pl, stype = int4, finalfunc = int4inc)';
    s := ddlx_create_aggregate('fix_fm(int)'::regprocedure::regproc);
    assert s like '%FINALFUNC_MODIFY = READ_WRITE%', 'READ_WRITE lost: ' || s;
    s := ddlx_create_aggregate('fix_fs(int)'::regprocedure::regproc);
    assert s like '%FINALFUNC_MODIFY = SHAREABLE%', 'SHAREABLE lost: ' || s;
    s := ddlx_create_aggregate('fix_fr(int)'::regprocedure::regproc);
    assert s not like '%FINALFUNC_MODIFY%', 'default must not be emitted: ' || s;

    s := ddlx_create_aggregate('fix_fm(int)'::regprocedure::regproc);
    execute 'drop aggregate fix_fm(int)';
    execute s;
    assert (select aggfinalmodify from pg_aggregate where aggfnoid = 'fix_fm(int)'::regprocedure) = 'w',
           'aggfinalmodify not restored';
  end if;
end $$;
rollback;
-- 16. Transforms: only the functions that exist, separated by a comma
begin;
create schema fix_test;
set local search_path = fix_test, public;
create transform for int4 language c (from sql with function varchar_support(internal),
                                      to sql with function int4recv(internal));
create transform for int8 language c (from sql with function varchar_support(internal));
create transform for int2 language c (to sql with function int2recv(internal));
do $$
declare t regtype; s text; n int; o oid;
begin
  foreach t in array array['int4','int8','int2']::regtype[] loop
    select oid into o from pg_transform where trftype = t;
    s := ddlx_create_transform(o);
    assert s not like '%WITH FUNCTION -%', 'bogus "-" function for ' || t || ': ' || s;
    execute format('drop transform for %s language c', t);
    execute s;   -- must be valid DDL
    select oid into o from pg_transform where trftype = t;
    assert ddlx_create_transform(o) = s, 'round trip differs for ' || t;
  end loop;

  select oid into o from pg_transform where trftype = 'int8'::regtype;
  s := ddlx_create_transform(o);
  assert s like '%FROM SQL%' and s not like '%TO SQL%', 'from-only: ' || s;
  select oid into o from pg_transform where trftype = 'int2'::regtype;
  s := ddlx_create_transform(o);
  assert s like '%TO SQL%' and s not like '%FROM SQL%', 'to-only: ' || s;
  select oid into o from pg_transform where trftype = 'int4'::regtype;
  s := ddlx_create_transform(o);
  assert s ~ 'FROM SQL WITH FUNCTION [^\n]*,\n  TO SQL', 'both need a comma: ' || s;
end $$;
rollback;
-- 17. Text search configurations: one ADD MAPPING per token with the whole dictionary chain
begin;
create schema fix_test;
set local search_path = fix_test, public;
create text search configuration fix_cfg (parser = default);
alter text search configuration fix_cfg add mapping for asciiword, word with english_stem, simple;
alter text search configuration fix_cfg add mapping for numword with simple;
alter text search configuration fix_cfg add mapping for "int", "float", uint with simple;
alter text search configuration fix_cfg add mapping for email, url with simple, english_stem;
do $$
declare s text; before text; after text;
begin
  select string_agg(t.alias || '=' || (select string_agg(m.mapdict::regdictionary::text, ',' order by m.mapseqno)
                                         from pg_ts_config_map m
                                        where m.mapcfg = 'fix_cfg'::regconfig and m.maptokentype = t.tokid), ';'
                    order by t.tokid)
    into before
    from ts_token_type((select cfgparser from pg_ts_config where oid = 'fix_cfg'::regconfig)) t
   where exists (select 1 from pg_ts_config_map m where m.mapcfg = 'fix_cfg'::regconfig and m.maptokentype = t.tokid);

  s := ddlx_create_text_search_config('fix_cfg'::regconfig);
  assert s ~ 'FOR asciiword, word WITH [^;]*english_stem, [^;]*simple;'
         or s ~ 'FOR asciiword WITH [^;]*english_stem, [^;]*simple;', 'dictionary chain not joined: ' || s;
  assert (select count(*) from regexp_matches(s, 'ADD MAPPING', 'g')) = 8,
         'one statement per token expected: ' || s;

  execute 'drop text search configuration fix_cfg';
  execute s;     -- must be valid DDL

  select string_agg(t.alias || '=' || (select string_agg(m.mapdict::regdictionary::text, ',' order by m.mapseqno)
                                        from pg_ts_config_map m
                                       where m.mapcfg = 'fix_cfg'::regconfig and m.maptokentype = t.tokid), ';'
                    order by t.tokid)
    into after
    from ts_token_type((select cfgparser from pg_ts_config where oid = 'fix_cfg'::regconfig)) t
   where exists (select 1 from pg_ts_config_map m where m.mapcfg = 'fix_cfg'::regconfig and m.maptokentype = t.tokid);

  assert before is not null and before = after, 'mappings differ: ' || before || ' <> ' || coalesce(after,'(null)');
end $$;
rollback;
-- 18. ALTER ROLE / ALTER DATABASE ... SET: values are quoted
begin;
create schema fix_test;
set local search_path = fix_test, public;
create role "Set Role";
alter role "Set Role" set application_name = 'my app 100%';
alter role "Set Role" set default_text_search_config = 'pg_catalog.english';
alter role "Set Role" set search_path = fix_test, "Odd Schema", public;
alter role "Set Role" set "DateStyle" = 'ISO, DMY';
alter role "Set Role" set work_mem = '64MB';
do $$
declare s text; before text[]; after text[]; l text; o oid;
begin
  select oid into o from pg_roles where rolname = 'Set Role';
  select array_agg(c order by c) into before from pg_roles, unnest(rolconfig) c where oid = o;
  s := ddlx_alter_role(o);
  assert s like '%SET application_name TO ''my app 100%%'';%', 'role value not quoted: ' || s;
  assert s like '%SET default_text_search_config TO ''pg_catalog.english'';%', 'role value not quoted: ' || s;
  assert s like '%SET search_path TO fix_test, "Odd Schema", public;%', 'list value mangled: ' || s;

  execute 'alter role "Set Role" reset all';
  foreach l in array string_to_array(s, E'\n') loop
    if l like 'ALTER ROLE % SET %' then execute l; end if;
  end loop;
  select array_agg(c order by c) into after from pg_roles, unnest(rolconfig) c where oid = o;
  assert before = after, 'role settings differ: ' || before::text || ' <> ' || coalesce(after::text,'(null)');
end $$;
do $$
declare s text; before text[]; after text[]; l text; o oid;
begin
  select oid into o from pg_database where datname = current_database();
  execute format('alter database %I reset all', current_database());
  execute format('alter database %I set application_name = %L', current_database(), 'my db 100%');
  execute format('alter database %I set default_text_search_config = %L', current_database(), 'pg_catalog.simple');
  execute format('alter database %I set search_path = fix_test, "Odd Schema", public', current_database());
  select setconfig into before from pg_db_role_setting where setdatabase = o and setrole = 0;
  s := ddlx_alter_database(o);
  assert s like '%SET application_name TO ''my db 100%%'';%', 'database value not quoted: ' || s;
  assert s like '%SET search_path TO fix_test, "Odd Schema", public;%', 'list value mangled: ' || s;

  execute format('alter database %I reset all', current_database());
  foreach l in array string_to_array(s, E'\n') loop
    if l like 'ALTER DATABASE % SET %' then execute l; end if;
  end loop;
  select setconfig into after from pg_db_role_setting where setdatabase = o and setrole = 0;
  assert (select array_agg(c order by c) from unnest(before) c)
       = (select array_agg(c order by c) from unnest(after) c),
         'database settings differ: ' || before::text || ' <> ' || coalesce(after::text,'(null)');
end $$;
rollback;
-- 19. Collations: columns, domains, ranges and CREATE COLLATION use collation names,
-- never the locale string, and nothing is written for the type's default collation
begin;
create schema fix_test;
set local search_path = fix_test, public;
create collation fix_c (provider = libc, locale = 'C');
create table fix_coll (
  a text,                       -- default collation: no clause
  b text collate "C",           -- explicit collation
  c text collate fix_c,
  d name                        -- type's own collation (C): no clause
);
create domain fix_cdom as text collate fix_c;
create domain fix_plain as text;
create type fix_rng as range (subtype = text, collation = "C");
do $$
declare s text; t text;
begin
  s := ddlx_create_table('fix_coll'::regclass);
  assert s like '%b text COLLATE pg_catalog."C"%', 'column collation: ' || s;
  assert s like '%c text COLLATE fix_test.fix_c%', 'column collation: ' || s;
  assert s not like '%a text COLLATE%' and s not like '%d name COLLATE%',
         'default collations must not be emitted: ' || s;

  -- the generated table definition is valid and keeps the collations
  execute 'drop table fix_coll';
  execute s;
  assert (select array_agg(attcollation::oid order by attnum)
            from pg_attribute where attrelid = 'fix_coll'::regclass and attnum > 0)
         = array[100, 950, (select oid from pg_collation where collname = 'fix_c'), 950]::oid[],
         'collations not preserved';

  s := ddlx_create_type_domain('fix_cdom'::regtype);
  assert s like '%COLLATE fix_test.fix_c%', 'domain collation: ' || s;
  s := ddlx_create_type_domain('fix_plain'::regtype);
  assert s not like '%COLLATE%', 'domain without own collation: ' || s;

  s := ddlx_create_type_range('fix_rng'::regtype);
  assert s like '%COLLATION = pg_catalog."C"%', 'range collation: ' || s;

  -- CREATE COLLATION round trip
  s := ddlx_create_collation((select oid from pg_collation where collname = 'fix_c'));
  assert s like '%LC_COLLATE = ''C''%' and s like '%LC_CTYPE = ''C''%', 'libc collation: ' || s;
  assert s not like '%NULL%', 'no NULLs in CREATE COLLATION: ' || s;
end $$;
rollback;
-- 19b. ICU collations have no LC_COLLATE/LC_CTYPE (PG15+): LOCALE is used instead
begin;
create schema fix_test;
set local search_path = fix_test, public;
do $$
declare s text; o oid;
begin
  if current_setting('server_version_num')::int >= 100000
     and exists (select 1 from pg_collation where collprovider = 'i')
     and (select pg_encoding_to_char(encoding) from pg_database where datname = current_database())
         not in ('SQL_ASCII') then
    execute 'create collation fix_icu (provider = icu, locale = ''und'', deterministic = false)'
      ;
    select oid into o from pg_collation where collname = 'fix_icu';
    s := ddlx_create_collation(o);
    assert s not like '%NULL%', 'no NULLs in ICU collation: ' || s;
    assert s like '%PROVIDER = icu%', 'provider: ' || s;
    if current_setting('server_version_num')::int >= 150000 then
      assert s like '%LOCALE = ''und''%' and s not like '%LC_COLLATE%', 'ICU locale: ' || s;
    end if;
    execute 'drop collation fix_icu';
    execute s;
    assert (select collprovider from pg_collation where collname = 'fix_icu') = 'i', 'not recreated as ICU';
  end if;
end $$;
rollback;
-- 19c. Databases: locale values are string literals, TEMPLATE template0, ICU settings (PG15+)
-- (CREATE DATABASE cannot run in a transaction block, so this section is not wrapped)
set client_min_messages = warning;
drop database if exists fix_coll_db;
reset client_min_messages;
select current_setting('server_version_num')::int >= 150000 and exists (select 1 from pg_collation where collprovider = 'i') as has_icu \gset
\if :has_icu
create database fix_coll_db template template0 encoding 'UTF8' locale_provider icu icu_locale 'und' lc_collate 'C' lc_ctype 'C';
\else
create database fix_coll_db template template0 encoding 'UTF8' lc_collate 'C' lc_ctype 'C';
\endif
select ddlx_create_database(oid) as ddl from pg_database where datname = 'fix_coll_db' \gset
select set_config('fix.ddl', :'ddl', false) is not null as ok \gset
do $$
declare s text := current_setting('fix.ddl');
begin
  assert s like '%TEMPLATE = template0%', 'template0: ' || s;
  assert s like '%LC_COLLATE = ''C''%' and s like '%LC_CTYPE = ''C''%', 'literals: ' || s;
  assert s not like '%NULL%', 'no NULLs: ' || s;
end $$;
drop database fix_coll_db;
select regexp_replace(:'ddl', ';.*$', '') as stmt \gset
:stmt;
select set_config('fix.same', (ddlx_create_database(oid) = :'ddl')::text, false) is not null as ok
  from pg_database where datname = 'fix_coll_db' \gset
do $$ begin assert current_setting('fix.same')::boolean, 'database round trip differs'; end $$;
drop database fix_coll_db;
-- 20. 'nosecrets' leaves out passwords: role password, FDW/server/user mapping
-- password options and the password in a subscription's connection string
begin;
create schema fix_test;
set local search_path = fix_test, public;
create role "Sec Role" password 'topsecret1';
create foreign data wrapper fix_fdw options (host 'fdwhost', password 'secret_fdw');
create server fix_srv foreign data wrapper fix_fdw options (host 'srvhost', password 'secret_srv');
create user mapping for public server fix_srv options (user 'mapuser', password 'secret_map', sslpassword 'secret_ssl');
do $$
declare s text; o oid;
begin
  -- role
  select oid into o from pg_roles where rolname = 'Sec Role';
  s := ddlx_alter_role(o);
  assert s like '%ENCRYPTED PASSWORD%', 'password expected without nosecrets: ' || s;
  s := ddlx_alter_role(o, '{nosecrets}');
  assert s not like '%PASSWORD%' and s like '%ALTER ROLE "Sec Role" WITH%', 'role password leaked: ' || s;
  s := ddlx_create(o, '{nosecrets}');
  assert s not like '%PASSWORD%', 'ddlx_create leaked the role password: ' || s;
  assert ddlx_create(o) like '%ENCRYPTED PASSWORD%', 'ddlx_create without nosecrets keeps the password';

  -- foreign data wrapper
  o := (select oid from pg_foreign_data_wrapper where fdwname = 'fix_fdw');
  s := ddlx_create(o);
  assert s like '%secret_fdw%', 'fdw password expected by default: ' || s;
  s := ddlx_create(o, '{nosecrets}');
  assert s not like '%secret_fdw%' and s like '%fdwhost%', 'fdw secret handling: ' || s;

  -- server
  o := (select oid from pg_foreign_server where srvname = 'fix_srv');
  s := ddlx_create(o);
  assert s like '%secret_srv%', 'server password expected by default: ' || s;
  s := ddlx_create(o, '{nosecrets}');
  assert s not like '%secret_srv%' and s like '%srvhost%', 'server secret handling: ' || s;

  -- user mapping
  o := (select umid from pg_user_mappings where srvname = 'fix_srv');
  s := ddlx_create(o);
  assert s like '%secret_map%' and s like '%secret_ssl%', 'mapping passwords expected by default: ' || s;
  s := ddlx_create(o, '{nosecrets}');
  assert s not like '%secret_map%' and s not like '%secret_ssl%' and s like '%mapuser%',
         'mapping secret handling: ' || s;
  -- still valid DDL
  execute 'drop user mapping for public server fix_srv';
  execute s;
end $$;
rollback;
-- 20b. subscriptions (PG10+); the connection string is parsed, not just cut
begin;
create schema fix_test;
set local search_path = fix_test, public;
set local client_min_messages = error;
do $$
declare s text; o oid;
begin
  if current_setting('server_version_num')::int >= 100000 then
    execute $q$create subscription fix_sub1
               connection 'host=localhost dbname=x password=sekrit1 port=5432'
               publication fix_pub with (connect = false, slot_name = none)$q$;
    execute $q$create subscription fix_sub2
               connection 'host=localhost password = ''se kr\''et2'' dbname=y'
               publication fix_pub with (connect = false, slot_name = none)$q$;

    o := (select oid from pg_subscription where subname = 'fix_sub1');
    s := ddlx_create_subscription(o);
    assert s like '%password=sekrit1%', 'conninfo expected by default: ' || s;
    s := ddlx_create_subscription(o, '{nosecrets}');
    assert s not like '%sekrit1%' and s like '%host=localhost dbname=x port=5432%',
           'password must be removed, the rest kept: ' || s;

    o := (select oid from pg_subscription where subname = 'fix_sub2');
    s := ddlx_create_subscription(o, '{nosecrets}');
    assert s not like '%kr%et2%' and s not like '%se kr%' and s like '%dbname=y%',
           'quoted password must be removed: ' || s;
    assert ddlx_create(o, '{nosecrets}') not like '%et2%', 'ddlx_create leaked: ' || ddlx_create(o, '{nosecrets}');
  end if;
end $$;
rollback;
-- 21. Callers without superuser rights: policies, user mappings and subscriptions
begin;
create schema fix_test;
set local search_path = fix_test, public;
create role fix_plain;
grant usage on schema fix_test to fix_plain;
create role "Pol Role";
create table fix_pol_t (id int);
create policy fix_pol on fix_pol_t to "Pol Role" using (true);
create foreign data wrapper fix_fdw;
create server fix_srv foreign data wrapper fix_fdw;
grant usage on foreign data wrapper fix_fdw to fix_plain;
grant usage on foreign server fix_srv to fix_plain;
create user mapping for public server fix_srv options (user 'u', password 'p');
do $$
declare s text; o oid;
begin
  if current_setting('server_version_num')::int >= 90500 then
    o := (select oid from pg_policy where polname = 'fix_pol');
    set local role fix_plain;
    s := ddlx_create_policy(o);
    reset role;
    assert s like '%"Pol Role"%', 'policy roles must be readable without superuser: ' || s;
  end if;

  o := (select umid from pg_user_mappings where srvname = 'fix_srv');
  set local role fix_plain;
  s := ddlx_create_user_mapping(o);
  reset role;
  assert s like 'CREATE USER MAPPING%', 'user mapping as plain user: ' || coalesce(s,'(null)');
  assert s not like '%''p''%', 'options of a mapping the caller does not own must stay hidden: ' || s;

  if current_setting('server_version_num')::int >= 100000 then
    set local client_min_messages = error;
    execute $q$create subscription fix_sub3 connection 'host=localhost dbname=x password=sekrit3'
               publication fix_pub with (connect = false, slot_name = none)$q$;
    o := (select oid from pg_subscription where subname = 'fix_sub3');
    set local role fix_plain;
    s := ddlx_create_subscription(o);
    reset role;
    assert s like 'CREATE SUBSCRIPTION fix_sub3%', 'subscription as plain user: ' || coalesce(s,'(null)');
    assert s not like '%sekrit3%', 'conninfo must not be visible to a plain user: ' || s;
  end if;
end $$;
rollback;
-- 22. Script safety: names with CR/LF or "*/" must not break out of comments
begin;
create schema fix_test;
set local search_path = fix_test, public;
create table fix_victim (id int);
create table fix_normal (id int);
do $$
declare s text; b text; ok boolean; n text;
begin
  -- helpers
  assert ddlx_comment_out(E'ALTER TABLE "x\nDROP y"') = E'-- ALTER TABLE "x\n-- DROP y"\n', 'comment_out LF';
  assert ddlx_comment_out(E'a\r\nb\rc\nd;\n') = E'-- a\r\n-- b\r-- c\n-- d;\n', 'comment_out CR/LF';
  assert ddlx_comment_text(E'a\r\nb') = 'a\r\nb' , 'comment_text';

  -- banner with line breaks in the name stays a comment
  b := ddlx_banner(E'evil\ndrop table fix_victim;\rdrop table fix_victim;', 'TABLE', 'fix_test', E'o\nwner');
  assert b !~ E'[\r]', 'CR in banner: ' || b;
  assert (select bool_and(l = '' or l like '--%') from unnest(string_to_array(b, E'\n')) l),
         'banner must consist of comment lines only: ' || b;

  -- ordinary objects keep the block comment around the DROP section
  s := ddlx_script('fix_normal'::regclass::oid, '{nowrap}');
  assert s like E'%/*\n%DROP TABLE fix_normal;%*/\n%', 'block comment expected: ' || s;

  -- a name that would close the block comment early
  n := E'x */ ; drop table fix_victim; /* y';
  execute format('create table %I (id int)', n);
  s := ddlx_script(format('%I', n)::regclass::oid, '{nowrap}');
  assert s not like E'%/*\n%', 'must not use a block comment here: ' || s;
  execute format('drop table %I', n);
  execute s;     -- recreates the table; the commented DROP must not run
  assert to_regclass('fix_victim') is not null, 'script dropped an unrelated table';
  assert to_regclass(format('%I', n)) is not null, 'script did not recreate the table';

  -- a name containing a line break inside the DROP section
  n := E'line1\nline2';
  execute format('create table %I (id int)', n);
  s := ddlx_script(format('%I', n)::regclass::oid, '{nowrap}');
  execute format('drop table %I', n);
  execute s;
  assert to_regclass(format('%I', n)) is not null, 'table with newline not recreated';
end $$;
-- non-local (inherited) constraints are commented out as a whole (PG11+)
do $$
declare s text;
begin
  if current_setting('server_version_num')::int >= 110000 then
    execute 'create table fix_p (id int primary key) partition by range (id)';
    execute 'create table fix_p1 partition of fix_p for values from (1) to (10)';
    s := ddlx_create_index('fix_p1_pkey'::regclass);
    assert s like '-- ALTER TABLE %ADD CONSTRAINT%;' || E'\n', 'inherited constraint not commented: ' || s;
    s := ddlx_drop_index('fix_p1_pkey'::regclass);
    assert s like '-- ALTER TABLE %DROP CONSTRAINT%;' || E'\n', 'inherited constraint drop not commented: ' || s;
  end if;
end $$;
rollback;
-- 23. REPLICA IDENTITY: FULL, NOTHING, USING INDEX (also a primary key index), none for default
begin;
create schema fix_test;
set local search_path = fix_test, public;
create table fix_ri_d (id int primary key);
create table fix_ri_f (id int);
alter table fix_ri_f replica identity full;
create table fix_ri_n (id int);
alter table fix_ri_n replica identity nothing;
create table fix_ri_i (id int not null, "Odd Col" text);
create unique index "Fix Ri Idx" on fix_ri_i (id);
alter table fix_ri_i replica identity using index "Fix Ri Idx";
create table fix_ri_pk (id int primary key);
alter table fix_ri_pk replica identity using index fix_ri_pk_pkey;
create materialized view fix_ri_m as select 1 as id;
alter table fix_ri_m replica identity full;   -- matview columns are nullable: no USING INDEX
create view fix_ri_v as select 1 as id;
do $$
declare s text; t text; r text; n text; before text; after text;
begin
  assert ddlx_create('fix_ri_d'::regclass::oid) not like '%REPLICA IDENTITY%', 'default needs no statement';
  assert ddlx_create('fix_ri_v'::regclass::oid) not like '%REPLICA IDENTITY%', 'views have none';
  assert ddlx_create('fix_ri_f'::regclass::oid) like '%ALTER TABLE fix_ri_f REPLICA IDENTITY FULL;%', 'FULL';
  assert ddlx_create('fix_ri_n'::regclass::oid) like '%ALTER TABLE fix_ri_n REPLICA IDENTITY NOTHING;%', 'NOTHING';
  s := ddlx_create('fix_ri_i'::regclass::oid);
  assert s like '%REPLICA IDENTITY USING INDEX "Fix Ri Idx";%', 'USING INDEX: ' || s;
  assert strpos(s, 'CREATE UNIQUE INDEX "Fix Ri Idx"') < strpos(s, 'REPLICA IDENTITY'),
         'the index must exist before it is used: ' || s;
  s := ddlx_create('fix_ri_pk'::regclass::oid);
  assert s like '%REPLICA IDENTITY USING INDEX fix_ri_pk_pkey;%', 'primary key index: ' || s;
  assert strpos(s, 'PRIMARY KEY') < strpos(s, 'REPLICA IDENTITY'), 'constraint first: ' || s;
  assert ddlx_create('fix_ri_m'::regclass::oid) like '%ALTER TABLE fix_ri_m REPLICA IDENTITY FULL;%', 'matview';

  -- options
  assert ddlx_create('fix_ri_f'::regclass::oid, '{lite}') not like '%REPLICA IDENTITY%', 'lite';
  assert ddlx_create('fix_ri_i'::regclass::oid, '{noindexes}') not like '%REPLICA IDENTITY%',
         'USING INDEX is meaningless without indexes';
  -- replica identity belongs to the indexes part, so 'noindexes' leaves all of it out
  assert ddlx_create('fix_ri_f'::regclass::oid, '{noindexes}') not like '%REPLICA IDENTITY%',
         'noindexes omits the indexes part';

  -- round trip: the recreated tables have the same replica identity
  foreach t in array array['fix_ri_f','fix_ri_n','fix_ri_i','fix_ri_pk'] loop
    select relreplident::text || coalesce((select i.relname from pg_index x join pg_class i on i.oid = x.indexrelid
                                            where x.indrelid = c.oid and x.indisreplident), '')
      into before from pg_class c where c.oid = t::regclass;
    s := ddlx_create(t::regclass::oid);
    execute format('drop table %I', t);
    execute s;
    select relreplident::text || coalesce((select i.relname from pg_index x join pg_class i on i.oid = x.indexrelid
                                            where x.indrelid = c.oid and x.indisreplident), '')
      into after from pg_class c where c.oid = t::regclass;
    assert before = after, 'replica identity of ' || t || ' differs: ' || before || ' <> ' || after;
  end loop;
end $$;
rollback;
-- 24. SECURITY LABEL: objects, columns, shared objects, several providers
-- (no label provider is available in a plain server, so the rows are inserted into the
--  catalogs directly; the statements must parse, and then fail only for the missing provider)
begin;
create schema fix_test;
set local search_path = fix_test, public;
create role "Lab Role";
create table fix_sl (id int, "Odd Col" text);
create function fix_sl_fn(int) returns int language sql as 'select $1';
create view fix_sl_v as select 1 as id;
insert into pg_seclabel (objoid, classoid, objsubid, provider, label) values
  ('fix_sl'::regclass::oid,  'pg_class'::regclass::oid, 0, 'fixprov', 'table label'),
  ('fix_sl'::regclass::oid,  'pg_class'::regclass::oid, 2, 'fixprov', 'it''s a column'),
  ('fix_sl'::regclass::oid,  'pg_class'::regclass::oid, 0, 'aaaprov', 'first provider'),
  ('fix_sl_v'::regclass::oid,'pg_class'::regclass::oid, 0, 'fixprov', 'view label'),
  ('fix_sl_fn(int)'::regprocedure::oid, 'pg_proc'::regclass::oid, 0, 'fixprov', 'function label'),
  ('fix_test'::regnamespace::oid, 'pg_namespace'::regclass::oid, 0, 'fixprov', 'schema label');
insert into pg_shseclabel (objoid, classoid, provider, label)
  select oid, 'pg_authid'::regclass::oid, 'fixprov', 'role label' from pg_roles where rolname = 'Lab Role';
do $$
declare s text; l text; o oid;
begin
  s := ddlx_security_label('fix_sl'::regclass::oid);
  assert s like E'%SECURITY LABEL FOR fixprov ON TABLE fix_sl IS ''table label'';\n%', 'table: ' || s;
  assert s like E'%SECURITY LABEL FOR fixprov ON COLUMN fix_sl."Odd Col" IS ''it''''s a column'';\n%', 'column: ' || s;
  assert strpos(s, 'aaaprov') < strpos(s, 'fixprov'), 'ordered by provider: ' || s;
  assert ddlx_security_label('fix_sl_v'::regclass::oid) like '%ON VIEW fix_sl_v IS ''view label'';%', 'view';
  assert ddlx_security_label('fix_sl_fn(int)'::regprocedure::oid) like '%ON FUNCTION fix_sl_fn(integer) IS ''function label'';%',
         'function: ' || ddlx_security_label('fix_sl_fn(int)'::regprocedure::oid);
  assert ddlx_security_label('fix_test'::regnamespace::oid) like '%ON SCHEMA fix_test IS ''schema label'';%', 'schema';
  select oid into o from pg_roles where rolname = 'Lab Role';
  assert ddlx_security_label(o) like '%SECURITY LABEL FOR fixprov ON ROLE "Lab Role" IS ''role label'';%',
         'role: ' || ddlx_security_label(o);

  -- no label, no output; another object with the same oid in a different catalog is not confused
  assert ddlx_security_label('fix_sl_fn(int)'::regprocedure::oid) not like '%table label%', 'class aware';
end $$;
do $$
declare s text; stmt text;
begin
  -- part of the full definition, and switchable
  s := ddlx_create('fix_sl'::regclass::oid);
  assert s like '%SECURITY LABEL FOR fixprov ON TABLE fix_sl%', 'ddlx_create includes labels: ' || s;
  assert strpos(s, 'CREATE TABLE') < strpos(s, 'SECURITY LABEL'), 'labels after the object: ' || s;
  assert ddlx_create('fix_sl'::regclass::oid, '{nolabels}') not like '%SECURITY LABEL%', 'nolabels';
  assert ddlx_create('fix_sl'::regclass::oid, '{lite}') not like '%SECURITY LABEL%', 'lite';
  assert ddlx_createonly('fix_sl'::regclass::oid) like '%SECURITY LABEL%', 'createonly includes labels';
  assert ddlx_script('fix_sl'::regclass::oid) like '%SECURITY LABEL FOR fixprov ON TABLE%', 'script includes labels';

  -- every statement parses: it can only fail because the provider is not loaded
  for stmt in select unnest(string_to_array(trim(trailing E'\n' from
                ddlx_security_label('fix_sl'::regclass::oid)), E'\n')) loop
    begin
      execute stmt;
    exception when invalid_parameter_value then null;   -- "provider ... is not loaded"
    end;
  end loop;
end $$;
rollback;
-- 25. Volatility: the generators only read the catalogs, they never write
select p.proname, p.provolatile
  from pg_proc p
 where p.proname like 'ddlx\_%' and pg_function_is_visible(p.oid)
   and p.provolatile = 'v'
 order by 1;
 proname | provolatile 
---------+-------------
(0 rows)

select count(*) > 50 as many_stable
  from pg_proc p
 where p.proname like 'ddlx\_%' and pg_function_is_visible(p.oid) and p.provolatile = 's';
 many_stable 
-------------
 t
(1 row)

select string_agg(distinct p.proname, ', ' order by p.proname) as immutable_ones
  from pg_proc p
 where p.proname like 'ddlx\_%' and pg_function_is_visible(p.oid) and p.provolatile = 'i';
                      immutable_ones                      
----------------------------------------------------------
 ddlx_comment_out, ddlx_comment_text, ddlx_set_config_sql
(1 row)

-- 26. ALTER DEFAULT PRIVILEGES: objects of kind pg_default_acl
begin;
create schema fix_test;
set local search_path = fix_test, public;
create role "Def Owner";
create role "Def Grantee";
alter default privileges for role "Def Owner" in schema fix_test
  grant select, insert on tables to "Def Grantee" with grant option;
alter default privileges for role "Def Owner" in schema fix_test grant usage on sequences to public;
alter default privileges for role "Def Owner" revoke execute on functions from public;
alter default privileges for role "Def Owner" grant select on tables to "Def Grantee";
do $$
declare o oid; s text; creates text; drops text; before text; after text; r record;
begin
  select oid into o from pg_roles where rolname = 'Def Owner';
  assert (select count(*) from pg_default_acl where defaclrole = o) = 4, 'setup';

  -- identification and the generic entry points
  for r in select oid from pg_default_acl where defaclrole = o loop
    assert (select sql_kind from ddlx_identify(r.oid)) = 'DEFAULT PRIVILEGES', 'identify';
    s := ddlx_create(r.oid);
    assert s like '%ALTER DEFAULT PRIVILEGES FOR ROLE "Def Owner"%', 'create: ' || s;
    assert s not like '%OWNER TO%', 'no OWNER TO for default privileges: ' || s;
    assert ddlx_drop(r.oid) like '%ALTER DEFAULT PRIVILEGES FOR ROLE "Def Owner"%REVOKE ALL%', 'drop';
  end loop;

  -- spot checks of the generated statements
  select string_agg(ddlx_create_default_acl(oid), '' order by oid) into creates
    from pg_default_acl where defaclrole = o;
  assert creates like '%ALTER DEFAULT PRIVILEGES FOR ROLE "Def Owner" IN SCHEMA fix_test GRANT INSERT, SELECT ON TABLES TO "Def Grantee" WITH GRANT OPTION;%',
         'schema entry: ' || creates;
  assert creates like '%IN SCHEMA fix_test GRANT USAGE ON SEQUENCES TO PUBLIC;%', 'PUBLIC: ' || creates;
  assert creates like '%FOR ROLE "Def Owner" REVOKE ALL ON FUNCTIONS FROM PUBLIC;%', 'global revoke: ' || creates;
  assert creates like '%FOR ROLE "Def Owner" GRANT SELECT ON TABLES TO "Def Grantee";%', 'global grant: ' || creates;
  assert creates not like '%IN SCHEMA fix_test REVOKE%', 'schema entries only add: ' || creates;

  -- the drop statements remove everything, the create statements restore it
  select string_agg(defaclobjtype::text || ':' || defaclnamespace::oid::text || ':' || defaclacl::text, ';' order by defaclobjtype, defaclnamespace)
    into before from pg_default_acl where defaclrole = o;
  select string_agg(ddlx_drop_default_acl(oid), '' order by oid) into drops
    from pg_default_acl where defaclrole = o;
  execute drops;
  assert (select count(*) from pg_default_acl where defaclrole = o) = 0,
         'drop must restore the built-in defaults: ' || drops;
  execute creates;
  select string_agg(defaclobjtype::text || ':' || defaclnamespace::oid::text || ':' || defaclacl::text, ';' order by defaclobjtype, defaclnamespace)
    into after from pg_default_acl where defaclrole = o;
  assert before = after, 'round trip differs: ' || before || ' <> ' || coalesce(after, '(null)');
end $$;
rollback;
-- 27. Table access methods (PG12+): USING is written when it is not the default
begin;
create schema fix_test;
set local search_path = fix_test, public;
do $$
declare s text; n text;
begin
  if current_setting('server_version_num')::int >= 120000 then
    execute 'create access method fix_heap type table handler heap_tableam_handler';
    execute 'create table fix_am_t (id int) using fix_heap';
    execute 'create table fix_am_h (id int)';
    execute 'create materialized view fix_am_m using fix_heap as select 1 as id';
    execute 'create materialized view fix_am_mh as select 1 as id';
    execute 'create table fix_am_p (id int) partition by range (id)';
    execute 'create table fix_am_c partition of fix_am_p for values from (1) to (5) using fix_heap';

    assert ddlx_create_table('fix_am_t'::regclass) like '%USING fix_heap;%', 'table: ' || ddlx_create_table('fix_am_t'::regclass);
    assert ddlx_create_table('fix_am_h'::regclass) not like '%USING%', 'heap needs no USING';
    assert ddlx_create_table('fix_am_t'::regclass, '{lite}') not like '%USING%', 'lite';
    assert ddlx_create_table('fix_am_c'::regclass) like '%FOR VALUES FROM (1) TO (5)%USING fix_heap;%',
           'partition: ' || ddlx_create_table('fix_am_c'::regclass);
    assert ddlx_create_view('fix_am_m'::regclass) like 'CREATE MATERIALIZED VIEW % USING fix_heap AS%',
           'matview: ' || ddlx_create_view('fix_am_m'::regclass);
    assert ddlx_create_view('fix_am_mh'::regclass) not like '%USING%', 'matview heap';

    -- valid DDL, same method after a round trip
    foreach n in array array['fix_am_t','fix_am_c'] loop
      s := ddlx_create_table(n::regclass);
      execute format('drop table %I', n);
      execute s;
      assert (select am.amname from pg_class c join pg_am am on am.oid = c.relam where c.oid = n::regclass) = 'fix_heap',
             'access method lost for ' || n;
    end loop;
    s := ddlx_create_view('fix_am_m'::regclass);
    execute 'drop materialized view fix_am_m';
    execute s;
    assert (select am.amname from pg_class c join pg_am am on am.oid = c.relam where c.oid = 'fix_am_m'::regclass) = 'fix_heap',
           'matview access method lost';

    -- when the default was changed, heap has to be spelled out
    execute 'set local default_table_access_method = fix_heap';
    execute 'create table fix_am_explicit (id int) using heap';
    s := ddlx_create_table('fix_am_explicit'::regclass);
    assert s like '%USING heap;%', 'explicit heap under a changed default: ' || s;
    execute 'reset default_table_access_method';
  end if;
end $$;
rollback;
-- 28. Rules: disabled rules are left out, enabled and replica rules are kept
begin;
create schema fix_test;
set local search_path = fix_test, public;
create table fix_rl (id int);
create table fix_rl_log (id int);
create rule fix_r_on as on insert to fix_rl do also insert into fix_rl_log values (new.id);
create rule fix_r_off as on update to fix_rl do also insert into fix_rl_log values (old.id);
create rule fix_r_rep as on delete to fix_rl do also insert into fix_rl_log values (old.id);
alter table fix_rl disable rule fix_r_off;
alter table fix_rl enable replica rule fix_r_rep;
do $$
declare s text;
begin
  s := ddlx_create('fix_rl'::regclass::oid);
  assert s like '%CREATE RULE fix_r_on %', 'enabled rule expected: ' || s;
  assert s like '%CREATE RULE fix_r_rep %', 'replica rule expected: ' || s;
  assert s not like '%fix_r_off%', 'disabled rule must be omitted: ' || s;
  assert ddlx_create_rules('fix_rl'::regclass) not like '%fix_r_off%', 'ddlx_create_rules';
  -- the rest of the table is not affected
  assert ddlx_create('fix_rl_log'::regclass::oid) not like '%CREATE RULE%', 'no rules on the other table';
end $$;
rollback;
-- 29. Event triggers: DISABLE / ENABLE REPLICA / ENABLE ALWAYS
begin;
create schema fix_test;
set local search_path = fix_test, public;
create function fix_etf() returns event_trigger language plpgsql as 'begin end';
create event trigger fix_et_on on ddl_command_end execute function fix_etf();
create event trigger fix_et_off on ddl_command_end execute function fix_etf();
create event trigger fix_et_rep on ddl_command_end execute function fix_etf();
create event trigger fix_et_alw on ddl_command_end execute function fix_etf();
alter event trigger fix_et_off disable;
alter event trigger fix_et_rep enable replica;
alter event trigger fix_et_alw enable always;
do $$
declare t text; s text; o oid; before "char"; after "char";
begin
  assert ddlx_create((select oid from pg_event_trigger where evtname = 'fix_et_on')) not like '%ALTER EVENT TRIGGER%',
         'enabled needs no ALTER';
  foreach t in array array['fix_et_off','fix_et_rep','fix_et_alw'] loop
    select oid, evtenabled into o, before from pg_event_trigger where evtname = t;
    s := ddlx_create(o);
    assert s like '%ALTER EVENT TRIGGER ' || t || case t when 'fix_et_off' then ' DISABLE;%'
                                                         when 'fix_et_rep' then ' ENABLE REPLICA;%'
                                                         else ' ENABLE ALWAYS;%' end,
           'state of ' || t || ': ' || s;
    execute format('drop event trigger %I', t);
    execute s;
    select evtenabled into after from pg_event_trigger where evtname = t;
    assert before = after, 'state of ' || t || ' not restored';
  end loop;
end $$;
rollback;
-- 30. Extended statistics: the statistics target (PG13+)
begin;
create schema fix_test;
set local search_path = fix_test, public;
create table fix_st (a int, b int);
create statistics fix_st_default (ndistinct) on a, b from fix_st;
create statistics fix_st_target (ndistinct) on a, b from fix_st;
do $$
declare s text; n text;
begin
  if current_setting('server_version_num')::int >= 130000 then
    execute 'alter statistics fix_st_target set statistics 250';
    assert ddlx_create((select oid from pg_statistic_ext where stxname = 'fix_st_default')) not like '%SET STATISTICS%',
           'default target needs no ALTER';
    s := ddlx_create((select oid from pg_statistic_ext where stxname = 'fix_st_target'));
    assert s like '%ALTER STATISTICS %fix_st_target SET STATISTICS 250;%', 'target: ' || s;
    assert strpos(s, 'CREATE STATISTICS') < strpos(s, 'ALTER STATISTICS'), 'order: ' || s;
    assert ddlx_create('fix_st'::regclass::oid) like '%SET STATISTICS 250;%', 'part of the table definition';

    execute 'drop statistics fix_st_target';
    execute s;
    assert (select stxstattarget from pg_statistic_ext where stxname = 'fix_st_target') = 250, 'not restored';
  end if;
end $$;
rollback;
-- 31. Tablespace of indexes and of the indexes behind constraints (unless nostorage / lite)
-- (a plain server has no usable tablespace, so pg_global is put into pg_class to get a name)
begin;
create schema fix_test;
set local search_path = fix_test, public;
create table fix_ts (id int primary key, v text unique, w text);
create index fix_ts_i on fix_ts (w);
update pg_class set reltablespace = 1664
 where oid in ('fix_ts_i'::regclass, 'fix_ts_pkey'::regclass, 'fix_ts_v_key'::regclass);
do $$
declare s text;
begin
  assert ddlx_create_index('fix_ts_i'::regclass) like E'%(w) TABLESPACE pg_global;\n', 'index: ' || ddlx_create_index('fix_ts_i'::regclass);
  assert ddlx_create_index('fix_ts_i'::regclass, '{nostorage}') not like '%TABLESPACE%', 'nostorage';
  assert ddlx_create_index('fix_ts_i'::regclass, '{lite}') not like '%TABLESPACE%', 'lite';
  s := ddlx_create('fix_ts'::regclass::oid);
  assert s like '%PRIMARY KEY (id) USING INDEX TABLESPACE pg_global%', 'primary key: ' || s;
  assert s like '%UNIQUE (v) USING INDEX TABLESPACE pg_global%', 'unique: ' || s;
  assert s like '%(w) TABLESPACE pg_global;%', 'index in the table definition: ' || s;
  s := ddlx_create('fix_ts'::regclass::oid, '{nostorage}');
  assert s not like '%TABLESPACE%', 'nostorage: ' || s;
  assert ddlx_create_constraint((select oid from pg_constraint where conname = 'fix_ts_pkey'))
         like '%USING INDEX TABLESPACE pg_global;%', 'ddlx_create_constraint';
  -- indexes in the default tablespace stay as they were
  assert ddlx_create_index('fix_ts_i'::regclass) is not null;
end $$;
rollback;
-- 31b. Storage parameters of the indexes behind constraints: WITH (...) is kept
begin;
create schema fix_test;
set local search_path = fix_test, public;
create table fix_wo (id int primary key with (fillfactor = 70), v text unique with (fillfactor = 80, deduplicate_items = off),
                     w int, constraint fix_wo_ex exclude using hash (w with =) with (fillfactor = 60));
create table fix_wo_plain (id int primary key);
do $$
declare s text; t text; before text; after text;
begin
  s := ddlx_create('fix_wo'::regclass::oid);
  assert s like '%PRIMARY KEY (id) WITH (fillfactor=''70'')%', 'primary key: ' || s;
  assert s like '%UNIQUE (v) WITH (deduplicate_items=''off'', fillfactor=''80'')%'
      or s like '%UNIQUE (v) WITH (fillfactor=''80'', deduplicate_items=''off'')%'
      or current_setting('server_version_num')::int < 130000, 'unique: ' || s;
  assert s like '%EXCLUDE USING hash (w WITH =) WITH (fillfactor=''60'');%', 'exclusion: ' || s;
  -- (the exclusion constraint shows its WITH in pg_get_constraintdef itself, so it stays)
  assert ddlx_create('fix_wo'::regclass::oid, '{nostorage}') not like '%PRIMARY KEY (id) WITH%'
     and ddlx_create('fix_wo'::regclass::oid, '{nostorage}') not like '%UNIQUE (v) WITH%', 'nostorage: ' || ddlx_create('fix_wo'::regclass::oid, '{nostorage}');
  assert ddlx_create('fix_wo'::regclass::oid, '{lite}') not like '%fillfactor=''70''%', 'lite';
  assert ddlx_create('fix_wo_plain'::regclass::oid) not like '%WITH (%', 'nothing to add: ' || ddlx_create('fix_wo_plain'::regclass::oid);
  assert ddlx_create_constraint((select oid from pg_constraint where conname = 'fix_wo_pkey'))
         like '%PRIMARY KEY (id) WITH (fillfactor=''70'');%', 'ddlx_create_constraint';

  -- round trip: the indexes have the same options afterwards
  select string_agg(c.relname || ':' || coalesce((select array_agg(o order by o) from unnest(c.reloptions) o)::text, ''), ';' order by c.relname)
    into before from pg_class c where c.relnamespace = 'fix_test'::regnamespace and c.relname like 'fix_wo%' and c.relkind = 'i';
  execute 'drop table fix_wo';
  execute s;
  select string_agg(c.relname || ':' || coalesce((select array_agg(o order by o) from unnest(c.reloptions) o)::text, ''), ';' order by c.relname)
    into after from pg_class c where c.relnamespace = 'fix_test'::regnamespace and c.relname like 'fix_wo%' and c.relkind = 'i';
  assert before = after, 'index options differ: ' || before || ' <> ' || after;
end $$;
rollback;
-- 32. Sequences: data type, cache, identity sequences, current value
begin;
create schema fix_test;
set local search_path = fix_test, public;
create sequence fix_sq_big;
create sequence fix_sq_small as smallint increment by 2 minvalue 3 maxvalue 1000 start 7 cache 20 cycle;
create sequence fix_sq_used cache 10;
select nextval('fix_sq_used');
 nextval 
---------
       1
(1 row)

create table fix_id (id int generated by default as identity (start 10 increment 3 cache 5), v int);
insert into fix_id (v) values (1);
do $$
declare s text; n text; before text; after text; q text; lv bigint;
begin
  assert ddlx_create('fix_sq_big'::regclass::oid) like '%CREATE SEQUENCE fix_sq_big;%', 'plain sequence stays plain';
  s := ddlx_create('fix_sq_small'::regclass::oid);
  assert s like '%CREATE SEQUENCE fix_sq_small AS smallint%', 'AS smallint: ' || s;
  assert s ~ 'CREATE SEQUENCE fix_sq_small AS smallint\n  INCREMENT BY 2\n  MINVALUE 3\n  MAXVALUE 1000\n  START WITH 7\n  CACHE 20\n  CYCLE;',
         'parameters belong to CREATE SEQUENCE: ' || s;

  -- round trip of the sequence parameters
  foreach n in array array['fix_sq_big','fix_sq_small','fix_sq_used'] loop
    select (s.seqtypid::regtype, s.seqstart, s.seqincrement, s.seqmax, s.seqmin, s.seqcache, s.seqcycle)::text
      into before from pg_sequence s where s.seqrelid = n::regclass;
    q := ddlx_create(n::regclass::oid);
    execute format('drop sequence %I', n);
    execute q;
    select (s.seqtypid::regtype, s.seqstart, s.seqincrement, s.seqmax, s.seqmin, s.seqcache, s.seqcycle)::text
      into after from pg_sequence s where s.seqrelid = n::regclass;
    assert before = after, n || ' differs: ' || before || ' <> ' || after;
  end loop;

  -- current value only on request, and only once nextval was called
  perform nextval('fix_sq_used');    -- the round trip above started the sequence over
  assert ddlx_create('fix_sq_used'::regclass::oid) not like '%setval%', 'no setval by default';
  s := ddlx_create('fix_sq_used'::regclass::oid, '{setval}');
  assert s like '%SELECT pg_catalog.setval(''fix_sq_used'', 10, true);%', 'setval: ' || s;
  assert ddlx_create('fix_sq_used'::regclass::oid, '{data}') like '%setval%', 'data implies setval';
  assert ddlx_create('fix_sq_big'::regclass::oid, '{setval}') not like '%setval%', 'never called: nothing to restore';

  -- identity column: the sequence parameters come with the table
  s := ddlx_create('fix_id'::regclass::oid);
  assert s like '%ALTER SEQUENCE fix_id_id_seq%INCREMENT BY 3%START WITH 10%CACHE 5%', 'identity sequence: ' || s;
  assert ddlx_create('fix_id'::regclass::oid, '{nosettings}') not like '%ALTER SEQUENCE%', 'nosettings';
  assert ddlx_create('fix_id'::regclass::oid) not like '%setval%', 'no setval by default';
  lv := pg_sequence_last_value('fix_id_id_seq'::regclass);   -- the cached range, not the last id
  assert lv >= 10, 'sequence was used';
  assert ddlx_create('fix_id'::regclass::oid, '{setval}') like format('%%setval(''fix_id_id_seq'', %s, true)%%', lv),
         'setval for identity: ' || ddlx_create('fix_id'::regclass::oid, '{setval}');

  select (s.seqtypid::regtype, s.seqstart, s.seqincrement, s.seqmax, s.seqmin, s.seqcache, s.seqcycle)::text
    into before from pg_sequence s where s.seqrelid = 'fix_id_id_seq'::regclass;
  s := ddlx_create('fix_id'::regclass::oid, '{setval}');
  execute 'drop table fix_id';
  execute s;
  select (s2.seqtypid::regtype, s2.seqstart, s2.seqincrement, s2.seqmax, s2.seqmin, s2.seqcache, s2.seqcycle)::text
    into after from pg_sequence s2 where s2.seqrelid = 'fix_id_id_seq'::regclass;
  assert before = after, 'identity sequence differs: ' || before || ' <> ' || after;
  assert pg_sequence_last_value('fix_id_id_seq'::regclass) = lv, 'identity value restored';

  -- without setval the sequences start from their start value, not from 1
  s := ddlx_create('fix_id'::regclass::oid);
  execute 'drop table fix_id';
  execute s;
  execute 'insert into fix_id (v) values (1)';
  assert (select id from fix_id) = 10, 'identity must start at its START value';
  q := ddlx_create('fix_sq_small'::regclass::oid);
  execute 'drop sequence fix_sq_small';
  execute q;
  assert nextval('fix_sq_small') = 7, 'sequence must start at its START value';
end $$;
rollback;
-- 32b. Sequences that the bare CREATE SEQUENCE could not recreate (descending, bounds above 1)
begin;
create schema fix_test;
set local search_path = fix_test, public;
create sequence fix_sq_desc increment by -3 start 100 minvalue -50 maxvalue 100;
create sequence fix_sq_high minvalue 100 maxvalue 200 start 150;
create sequence fix_sq_int as integer start 5;
do $$
declare n text; before text; after text; q text;
begin
  foreach n in array array['fix_sq_desc','fix_sq_high','fix_sq_int'] loop
    select (s.seqtypid::regtype, s.seqstart, s.seqincrement, s.seqmax, s.seqmin, s.seqcache, s.seqcycle)::text
      into before from pg_sequence s where s.seqrelid = n::regclass;
    q := ddlx_create(n::regclass::oid);
    execute format('drop sequence %I', n);
    execute q;
    select (s.seqtypid::regtype, s.seqstart, s.seqincrement, s.seqmax, s.seqmin, s.seqcache, s.seqcycle)::text
      into after from pg_sequence s where s.seqrelid = n::regclass;
    assert before = after, n || ' differs: ' || before || ' <> ' || after;
  end loop;
  assert nextval('fix_sq_high') = 150, 'start value of fix_sq_high';
  assert nextval('fix_sq_desc') = 100, 'start value of fix_sq_desc';
end $$;
rollback;
-- 33. Class-aware ddlx_identify: duplicate oids across catalogs
-- (system objects can share an oid between catalogs; a dummy schema is given
-- the oid of a user table to provoke the same situation)
begin;
create schema fix_test;
set local search_path = fix_test, public;
create table fix_dup (id int primary key, v text);
comment on table fix_dup is 'the table';
create table fix_dup_child (id int references fix_dup);
do $$
declare t oid := 'fix_test.fix_dup'::regclass::oid; r record; q text; c oid;
begin
  insert into pg_namespace (oid, nspname, nspowner) values (t, 'fix_dup_ns', 10);

  -- the set function returns every match, in priority order
  assert (select count(*) from ddlx_identify(t)) = 2, 'two matches expected';
  assert (select array_agg(classid::text order by ordinality)
            from ddlx_identify(t) with ordinality) = array['pg_class','pg_namespace'],
         'priority order: tables before schemas';
  -- the exact function returns one row per catalog
  assert (select name from ddlx_identify('pg_class'::regclass, t)) = 'fix_dup', 'exact pg_class';
  assert (select name from ddlx_identify('pg_namespace'::regclass, t)) = 'fix_dup_ns', 'exact pg_namespace';
  assert (select oid from ddlx_identify('pg_proc'::regclass, t)) is null, 'no match in other catalogs';
  assert (select classid from ddlx_identify('pg_namespace'::regclass, t)) = 'pg_namespace'::regclass;

  -- bare oid resolves by priority, exact form is unambiguous
  assert ddlx_create(t, '{nocomments}') like '%CREATE TABLE fix_dup%', 'bare oid: table wins';
  q := ddlx_create('pg_namespace'::regclass, t, '{nocomments}');
  assert q like '%CREATE SCHEMA%fix_dup_ns%' and q not like '%CREATE TABLE%', 'exact: schema ' || q;
  assert ddlx_drop('pg_namespace'::regclass, t, '{}') like 'DROP SCHEMA%fix_dup_ns%', 'exact drop';
  assert ddlx_drop('pg_class'::regclass, t, '{}') like 'DROP TABLE%fix_dup%', 'exact drop table';
  assert ddlx_drop(t) like 'DROP TABLE%', 'bare drop';
  assert ddlx_comment('pg_class'::regclass, t, '{comments}') like 'COMMENT ON TABLE%the table%', 'comment of the table';
  assert ddlx_comment('pg_namespace'::regclass, t, '{}') = '', 'schema has no comment';
  assert ddlx_alter_owner('pg_namespace'::regclass, t, '{owner}') like 'ALTER SCHEMA fix_dup_ns OWNER TO%', 'owner of schema';
  assert ddlx_grants('pg_namespace'::regclass, t, '{}') is not null, 'grants of schema';
  assert ddlx_security_label('pg_namespace'::regclass, t, '{}') = '', 'labels of schema';
  assert (select classid from ddlx_definitions('pg_namespace'::regclass, t, '{}')) = 'pg_namespace'::regclass;
  assert (select base_ddl from ddlx_definitions('pg_namespace'::regclass, t, '{}')) like '%CREATE SCHEMA%';
  assert (select base_ddl from ddlx_definitions(t)) like '%CREATE TABLE%', 'bare definitions: table';
  assert ddlx_createonly('pg_namespace'::regclass, t, '{}') like '%CREATE SCHEMA%';
  assert ddlx_alter('pg_namespace'::regclass, t, '{}') is not null;

  -- dependants are processed by (classid, oid), not by oid alone:
  -- give the foreign key constraint's oid to another schema as well
  select oid into c from pg_constraint where conrelid = 'fix_dup_child'::regclass and contype = 'f';
  insert into pg_namespace (oid, nspname, nspowner) values (c, 'fix_dup_ns2', 10);
  assert (select count(*) from ddlx_identify(c)) = 2, 'constraint oid is duplicated';
  select * into r from ddlx_script_parts('fix_dup'::regclass::oid);
  assert r.ddl_create_deps like '%FOREIGN KEY%' and r.ddl_create_deps not like '%fix_dup_ns2%',
         'dependant constraint must not be taken for a schema: ' || r.ddl_create_deps;
  assert r.ddl_drop_deps like '%DROP CONSTRAINT%' or r.ddl_drop_deps like '%DROP%', 'drop deps present';
end $$;
rollback;
-- 33b. Typed first argument with an options array must keep resolving to the bare oid versions
begin;
create schema fix_test;
set local search_path = fix_test, public;
create table fix_ov (id int primary key);
do $$
begin
  assert ddlx_create('fix_ov'::regclass, '{lite}') like '%CREATE TABLE fix_ov%', 'create';
  assert ddlx_createonly('fix_ov'::regclass, '{lite}') like '%CREATE TABLE fix_ov%', 'createonly';
  assert ddlx_alter('fix_ov'::regclass, '{lite}') is not null, 'alter';
  assert ddlx_drop('fix_ov'::regclass, '{ie}') like 'DROP TABLE IF EXISTS%', 'drop';
  assert ddlx_comment('fix_ov'::regclass, '{}') = '', 'comment';
  assert ddlx_alter_owner('fix_ov'::regclass, '{owner}') like 'ALTER TABLE%OWNER TO%', 'owner';
  assert ddlx_grants('fix_ov'::regclass, '{}') is not null, 'grants';
  assert ddlx_security_label('fix_ov'::regclass, '{}') is not null, 'labels';
  assert (select base_ddl from ddlx_definitions('fix_ov'::regclass, '{lite}')) like '%CREATE TABLE%', 'definitions';
  assert ddlx_script('fix_ov'::regclass::oid, '{nowrap}') like '%CREATE TABLE fix_ov%', 'script';
end $$;
rollback;
-- 34. Bare oid functions must use the exact ddlx_identify unless they are resolvers
-- (functions with a typed argument, or knowing their catalog, call the two argument form)
do $$
declare bad text;
begin
  select string_agg(p.proname || '(' || pg_get_function_identity_arguments(p.oid) || ')', ', ' order by p.proname)
    into bad
    from pg_proc p
   where p.proname like 'ddlx\_%'
     and p.prolang = (select oid from pg_language where lanname = 'sql')
     and p.prosrc ~ 'ddlx_identify\(\s*[A-Za-z0-9_.$]+\s*\)'
     and p.proname <> all (array['ddlx_comment','ddlx_security_label','ddlx_alter_owner','ddlx_grants',
          'ddlx_alter','ddlx_createonly','ddlx_create','ddlx_drop','ddlx_definitions','ddlx_get_dependants'])
     and p.proname not in ('ddlx_identify');
  assert bad is null, 'single argument ddlx_identify used by: ' || bad;
  -- and the allow-listed resolvers must be the bare oid versions only
  select string_agg(p.proname || '(' || pg_get_function_identity_arguments(p.oid) || ')', ', ')
    into bad
    from pg_proc p
   where p.proname = any (array['ddlx_comment','ddlx_security_label','ddlx_alter_owner','ddlx_grants',
          'ddlx_alter','ddlx_createonly','ddlx_create','ddlx_drop','ddlx_definitions','ddlx_get_dependants'])
     and p.prolang = (select oid from pg_language where lanname = 'sql')
     and p.prosrc ~ 'ddlx_identify\(\s*[A-Za-z0-9_.$]+\s*\)'
     and p.proargtypes[0] <> 'oid'::regtype;
  assert bad is null, 'typed variant uses single argument ddlx_identify: ' || bad;
end $$;
-- 35. pg_attver (an internal column option of some servers) is never output
begin;
create schema fix_test;
set local search_path = fix_test, public;
create table fix_av (a int, b text);
alter table fix_av alter a set (n_distinct = 5);
update pg_attribute set attoptions = coalesce(attoptions, '{}') || 'pg_attver=123456'::text
 where attrelid = 'fix_av'::regclass and attnum > 0;
do $$
begin
  assert ddlx_create('fix_av'::regclass::oid) not like '%pg_attver%', 'create';
  assert ddlx_create('fix_av'::regclass::oid) like '%n_distinct%', 'real column options are kept';
  assert ddlx_script('fix_av'::regclass::oid) not like '%pg_attver%', 'script';
  assert ddlx_alter_table_settings('fix_av'::regclass) not like '%pg_attver%', 'settings';
  assert not (select bool_or(options::text like '%pg_attver%') from ddlx_describe('fix_av'::regclass)), 'describe';
end $$;
rollback;
